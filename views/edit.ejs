<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Post</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/style/styles.css" />
  </head>
  <body class="bg-[#F6DDC3]">
    <%- include("partials/header") %>

    <main class="max-w-3xl mx-auto mt-12 px-6">
      <h1 class="text-2xl text-center text-black-600 mb-6">Edit Your Post</h1>

      <form action="/edit/<%= post.id %>" method="POST" class="space-y-6">
        <input
          type="text"
          name="title"
          value="<%= post.title %>"
          placeholder="Enter Title"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white mb-6"
          required
        />

        <textarea
          name="content"
          rows="6"
          placeholder="Write your content..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white mb-6"
          required
        >
<%= post.content %>
        </textarea>

        <!-- Button -->
        <div class="flex justify-end space-x-4">
          <a
            href="/"
            class="px-6 border border-gray-400 rounded bg-white hover:bg-gray-100 transition"
            >Cancel</a
          >
        </div>

        <button
          type="submit"
          class="px-6 py-2 bg-orange-600 text-white rounded-full hover:bg-orange-700 transition"
        >
          Save Changes
        </button>
      </form>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>
