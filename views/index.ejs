<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Board</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link rel="stylesheet" href="/style/styles.css" />
  </head>
  <body class="bg-[#F6DDC3]">
    <!-- Header NavBar -->
    <%- include("partials/header") %>

    <!-- Main Content -->
    <main class="max-w-3xl mx-auto mt-12 px-6 text-start">
      <!-- Branding -->
      <h1
        class="text-4xl font-bold leading-tight text-center"
        style="color: #eb4e00"
      >
        WELCOME <br />
        TO <br />
        BLOG BOARD
      </h1>
      <br />
      <!-- Button -->
      <div class="mt-2 mb-5 flex justify-center">
        <a
          href="/create"
          class="inline-flex items-center px-6 border border-gray-400 rounded-full bg-white hover:bg-gray-100 transition create-post-button"
        >
          Create new post
          <span class="ml-2 text-xl">+</span>
        </a>
      </div>
      <% if (posts.length === 0 ) { %>
      <div>
        <h2 class="font-medium text-black-600 text-center">No Post Yet!</h2>
        <h2 class="font-medium text-black-600 text-center">
          Your Posts Will Appear Here
        </h2>
      </div>
      <% } else { %>
      <div class="space-y-8">
        <% posts.forEach(post => { %>
        <article
          class="bg-white rounded-2xl shadow p-6 border border-gray-200 relative"
        >
          <!-- The three dots menu -->
          <div class="absolute top-4 right-4 group">
            <button class="p-1 rounded-full hover:bg-gray-100">
              <!-- three dots icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="currentColor"
                class="bi bi-three-dots"
                viewBox="0 0 16 16"
              >
                <path
                  d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3"
                />
              </svg>
            </button>
            <!-- dropdown hidden -->
            <div
              class="hidden group-hover:block absolute right-0 w-32 bg-white border rounded-lg shadow-lg"
            >
              <a
                href="/post/<%= post.id %>"
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                >View</a
              >
              <a
                href="/edit/<%= post.id %>"
                class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                >Edit</a
              >
              <form
                action="/delete/<%= post.id %>"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this post?')"
              >
                <button
                  type="submit"
                  class="w-full text-left px-4 py-2 hover:bg-gray-100 text-red-600"
                >
                  Delete
                </button>
              </form>
            </div>
          </div>

          <!-- The post content -->
          <h2 class="text-2xl font-semibold text-gray-900 mb-3">
            <%= post.title %>
          </h2>
          <p class="text-gray-700 leading-relaxed"><%= post.content %></p>
        </article>
        <% }) %>
      </div>
      <% } %>
    </main>

    <!-- Footer -->
    <%- include("partials/footer") %>
  </body>
</html>
