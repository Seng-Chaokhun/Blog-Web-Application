<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create Post</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/style/styles.css" />
  </head>
  <body class="bg-[#F6DDC3]">
    <%- include("partials/header") %>

    <main class="max-w-3xl mx-auto mt-12 px-6">
      <h2 class="text-2xl text-center text-black-600 mb-6">
        Create a New Post
      </h2>

      <form action="/submit-post" method="POST" class="space-y-4">
        <input
          type="text"
          name="title"
          placeholder="Post Title"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white mb-6"
          required
        />

        <textarea
          name="content"
          rows="6"
          placeholder="Write your post here..."
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-400 bg-white mb-6"
          required
        >
        </textarea>

        <button
          type="submit"
          class="px-6 py-2 bg-orange-600 text-white rounded-full hover:bg-orange-700 transition"
        >
          Publish Post
        </button>
      </form>
    </main>

    <%- include("partials/footer") %>
  </body>
</html>
